{
  "node_id": "NODE_ID",
  "peer_node_id": "PEER_NODE_ID",
  "role": "primary",
  "control_listen": "PRIMARY_IP:8099",
  "control_token": "REPLACE_WITH_A_SHARED_32_PLUS_CHAR_SECRET",
  "peers": [
    "http://RESERVE_IP:8099"
  ],
  "local_health_url": "http://127.0.0.1:8090/",
  "permit_path": "/home/USER/bot-api/permit/polydaemon-active-node",
  "deny_value": "maintenance",
  "start_cmd": [
    "docker",
    "compose",
    "-f",
    "/home/USER/bot-api/tg-bridge.yml",
    "-p",
    "tg-bridge",
    "--profile",
    "polydaemon-standby",
    "up",
    "-d"
  ],
  "stop_cmd": [
    "docker",
    "compose",
    "-f",
    "/home/USER/bot-api/tg-bridge.yml",
    "-p",
    "tg-bridge",
    "stop"
  ],
  "promote_after_s": 90,
  "probe_interval_s": 15,
  "state_path": "/home/USER/bot-api/failover-state.json"
}
