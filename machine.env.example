# PolyDaemon — this machine's settings for the channel plugin.
#
# Copy to ~/.config/polydaemon/machine.env, fill in, keep it private:
#   mkdir -p ~/.config/polydaemon
#   cp machine.env.example ~/.config/polydaemon/machine.env
#   chmod 600 ~/.config/polydaemon/machine.env
# then register the plugin with Claude Code:
#   python3 hooks/install.py --mcp
# Re-run that after editing this file or after a `git pull`.
#
# KEY=VALUE, one per line; an empty value means "not set".

# --- Always ------------------------------------------------------------------
# The bot's token from @BotFather — the same one the bot uses.
TG_BOT_TOKEN=
# A random secret (openssl rand -hex 32). On one machine any value will do; with
# several machines it must equal the bot's bot.registry_enroll_token.
TG_BRIDGE_AUTH_TOKEN=

# --- Several machines (docs/multi-machine.md) — leave empty on one machine -----
# The bot's registry, e.g. http://198.51.100.2:8090
TG_BRIDGE_BOT_URL=
# This machine's private address; the plugins listen on it.
TG_BRIDGE_BIND_HOST=
# Only if the bot must dial a different address than the one above.
TG_BRIDGE_ADVERTISE_HOST=

# --- Your own Bot API server, for files up to 2 GB (docs/large-files.md) -------
# e.g. http://198.51.100.2:8081 — must be the same server the bot uses.
TG_API_ROOT=
# To receive files when that server runs in Docker, possibly elsewhere:
TG_BOTAPI_SSH=
TG_BOTAPI_DOCKER=
TG_BOTAPI_CONTAINER=
TG_BOTAPI_WORKDIR=
